---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import CookieBanner from '../components/CookieBanner.astro';
import config from '../data/config.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = config.slogan,
  image,
  type = 'website',
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} | ${config.nombre}` : `${config.nombre} | ${config.slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/img/og-cover.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var tema = localStorage.getItem('leonas_shoop_tema');
          var oscuro =
            tema === 'dark' ||
            (tema !== 'light' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (oscuro) document.documentElement.classList.add('dark');
        } catch (e) {
          /* almacenamiento no disponible */
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#d97706" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Leonas Shoop" />

    <meta property="og:site_name" content={config.nombre} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Cloudflare Web Analytics (opcional): define PUBLIC_CF_BEACON_TOKEN en el entorno */}
    {
      import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
        />
      )
    }

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
        />
      )
    }
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
    <CookieBanner />

    <script>
      const elementos = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce =
        'matchMedia' in window && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        elementos.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('is-visible');
                observador.unobserve(entrada.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        elementos.forEach((el) => observador.observe(el));
      }
    </script>

    <script>
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>

    <script>
      // Favoritos: delegación global (funciona en tarjetas SSR y en vivo).
      import { toggleFav, esFav } from '../lib/favoritos';
      import { showToast } from '../scripts/toast';

      function pintarFavs() {
        for (const b of document.querySelectorAll<HTMLButtonElement>('.fav-btn[data-fav]')) {
          const activo = esFav(b.dataset.fav || '');
          b.setAttribute('aria-pressed', String(activo));
          b.classList.toggle('text-rose-600', activo);
          const svg = b.querySelector('svg');
          if (svg) svg.setAttribute('fill', activo ? 'currentColor' : 'none');
        }
        const n = document.querySelectorAll('.fav-btn[aria-pressed="true"]').length;
        for (const c of document.querySelectorAll<HTMLElement>('#favs-count')) {
          c.textContent = String(n);
          c.classList.toggle('hidden', n === 0);
        }
      }

      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.fav-btn[data-fav]');
        if (!b) return;
        e.preventDefault();
        e.stopPropagation();
        const added = toggleFav({
          id: b.dataset.fav || '',
          titulo: b.dataset.titulo || '',
          precio: Number(b.dataset.precio || 0),
          imagen: b.dataset.imagen || 'logo.svg',
        });
        if (added) {
          import('../lib/analytics').then(({ track }) =>
            track('fav_add', { producto_id: b.dataset.fav || '' }),
          ).catch(() => {});
        }
        showToast(added ? 'Guardado en favoritos' : 'Quitado de favoritos');
        pintarFavs();
      });
      window.addEventListener('favs:changed', pintarFavs);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', pintarFavs, { once: true });
      } else {
        pintarFavs();
      }
    </script>

    <script>
      // Analítica propia: page_view (una vez por página).
      import { track } from '../lib/analytics';
      track('page_view');
    </script>

    <script>
      // Datos en vivo: WhatsApp, horario, categorías y destacados desde la nube.
      import { hidratar, alCambiarConfig } from '../lib/vivo';
      import { fijarConfigViva } from '../lib/whatsapp';

      alCambiarConfig(fijarConfigViva);
      const arrancar = () => hidratar().catch(() => {});
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', arrancar, { once: true });
      } else {
        arrancar();
      }
    </script>
  </body>
</html>
