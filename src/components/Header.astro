---
import config from '../data/config.json';
import InstallButton from './InstallButton.astro';

const categorias = config.categorias;
const rutaActual = Astro.url.pathname;
const esActiva = (ruta: string) =>
  ruta === '/' ? rutaActual === '/' : rutaActual.startsWith(ruta);

const claseLink = (activa: boolean) =>
  activa
    ? 'bg-brand-50 text-accent'
    : 'text-fg-muted hover:bg-sunken hover:text-fg';
---

<header class="sticky top-0 z-50 border-b border-line bg-panel/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${config.nombre} - Inicio`}>
      <span class="shrink-0">
        <img
          src="/logo-leonas-shoop.png"
          alt=""
          width="72"
          height="84"
          fetchpriority="high"
          decoding="async"
          class="h-12 w-auto drop-shadow-[0_1px_6px_rgba(180,83,9,0.25)] sm:h-14"
        />
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-base font-extrabold tracking-tight text-fg">
          Leonas <span class="text-accent">Shoop</span>
        </span>
        <span class="hidden text-[11px] font-medium text-fg-subtle sm:block"
          >Primera y segunda mano</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      <a href="/" class:list={['rounded-lg px-3 py-2 text-sm font-medium', claseLink(esActiva('/') && rutaActual === '/')]}
        >Inicio</a
      >
      <a href="/catalogo" class:list={['rounded-lg px-3 py-2 text-sm font-medium', claseLink(esActiva('/catalogo'))]}
        >Catálogo</a
      >

      <details class="group relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-fg-muted hover:bg-sunken hover:text-fg [&::-webkit-details-marker]:hidden"
        >
          Categorías
          <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"
            ><path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"></path></svg
          >
        </summary>
        <div
          class="absolute right-0 top-full w-56 rounded-xl border border-line bg-panel p-2 shadow-xl shadow-black/10"
          data-categorias="menu"
        >
          {
            categorias.map((cat) => (
              <a
                href={`/catalogo?categoria=${cat.slug}`}
                data-slug={cat.slug}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-fg-muted hover:bg-brand-50 hover:text-accent"
              >
                {cat.nombre}
              </a>
            ))
          }
        </div>
      </details>

      <a href="/contacto" class:list={['rounded-lg px-3 py-2 text-sm font-medium', claseLink(esActiva('/contacto'))]}
        >Contacto</a
      >
    </nav>

    <div class="flex items-center gap-2">
      <InstallButton />

      <button type="button" id="theme-toggle" class="theme-btn" aria-label="Cambiar tema claro/oscuro">
        <svg class="theme-btn-luna hidden h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path></svg
        >
        <svg class="theme-btn-sol hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
          ><circle cx="12" cy="12" r="4.4"></circle><path
            d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path></svg
        >
      </button>

      <a
        href="/favoritos"
        class="relative hidden h-9 w-9 items-center justify-center rounded-xl border border-line bg-panel text-fg-muted transition hover:border-brand-400 hover:text-accent sm:flex"
        aria-label="Ver favoritos"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" stroke-linejoin="round"><path
            d="M19.5 12.6L12 20l-7.5-7.4A5 5 0 1112 6.2a5 5 0 117.5 6.4z"
          ></path></svg
        >
        <span
          id="favs-count"
          class="js-fav-count absolute -right-1.5 -top-1.5 hidden min-w-[1.25rem] rounded-full bg-rose-600 px-1 text-center text-[11px] font-bold leading-5 text-white"
          >0</span
        >
      </a>

      <a
        href="/carrito"
        class="relative flex h-9 w-9 items-center justify-center rounded-xl border border-line bg-panel text-fg-muted transition hover:border-brand-400 hover:text-accent"
        aria-label="Ver carrito"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"></circle><circle
            cx="18" cy="20" r="1.4"></circle><path
            d="M2 3h2.5l2.2 11.1a1.8 1.8 0 001.8 1.4h8.4a1.8 1.8 0 001.8-1.4L20.5 7H6"
          ></path></svg
        >
        <span
          id="cart-count"
          class="js-cart-count absolute -right-1.5 -top-1.5 hidden min-w-[1.25rem] rounded-full bg-brand-600 px-1 text-center text-[11px] font-bold leading-5 text-white"
          >0</span
        >
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-line bg-panel text-fg-muted transition hover:border-brand-400 hover:text-accent md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
      </button>
    </div>
  </div>

  <nav
    id="menu-movil"
    class="hidden border-t border-line bg-panel px-4 py-3 md:hidden"
    aria-label="Menú móvil"
  >
    <div class="flex flex-col gap-1">
      <a href="/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted hover:bg-sunken"
        >Inicio</a
      >
      <a
        href="/catalogo"
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted hover:bg-sunken">Catálogo</a
      >
      <a href="/favoritos" class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted hover:bg-sunken"
        >Favoritos</a
      >
      <div data-categorias="menu">
        {
          categorias.map((cat) => (
            <a
              href={`/catalogo?categoria=${cat.slug}`}
              data-slug={cat.slug}
              class="block rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted hover:bg-brand-50 hover:text-accent"
            >
              {cat.nombre}
            </a>
          ))
        }
      </div>
      <a href="/contacto"
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted hover:bg-sunken">Contacto</a
      >
    </div>
  </nav>
</header>

<script>
  import { contar } from '../lib/store';

  function sincronizarContador() {
    const n = contar();
    for (const el of document.querySelectorAll<HTMLElement>('.js-cart-count')) {
      el.textContent = String(n);
      el.classList.toggle('hidden', n === 0);
    }
  }

  sincronizarContador();
  window.addEventListener('cart:changed', sincronizarContador);
  window.addEventListener('storage', sincronizarContador);

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');
  toggle?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(abierto));
    toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });

  // Tema claro/oscuro (decide el usuario, se recuerda)
  const themeBtn = document.getElementById('theme-toggle');
  function pintarIconos() {
    const oscuro = document.documentElement.classList.contains('dark');
    themeBtn?.querySelector('.theme-btn-luna')?.classList.toggle('hidden', oscuro);
    themeBtn?.querySelector('.theme-btn-sol')?.classList.toggle('hidden', !oscuro);
  }
  pintarIconos();
  themeBtn?.addEventListener('click', () => {
    const oscuro = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('tema-leonas', oscuro ? 'dark' : 'light');
    } catch {}
    pintarIconos();
  });
</script>
