---
import config from '../data/config.json';

const categorias = config.categorias;
const rutaActual = Astro.url.pathname;
const esActiva = (ruta: string) =>
  ruta === '/' ? rutaActual === '/' : rutaActual.startsWith(ruta);
---

<header class="sticky top-0 z-50 border-b border-ink-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${config.nombre} - Inicio`}>
      <span
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-lg font-extrabold text-white"
        >L</span
      >
      <span class="flex flex-col leading-tight">
        <span class="text-base font-extrabold tracking-tight text-ink-900">{config.nombre}</span>
        <span class="hidden text-[11px] font-medium text-ink-500 sm:block"
          >Primera y segunda mano</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      <a
        href="/"
        class:list={[
          'rounded-lg px-3 py-2 text-sm font-medium',
          esActiva('/') && rutaActual === '/'
            ? 'bg-brand-50 text-brand-800'
            : 'text-ink-600 hover:bg-ink-100 hover:text-ink-900',
        ]}>Inicio</a
      >
      <a
        href="/catalogo"
        class:list={[
          'rounded-lg px-3 py-2 text-sm font-medium',
          esActiva('/catalogo')
            ? 'bg-brand-50 text-brand-800'
            : 'text-ink-600 hover:bg-ink-100 hover:text-ink-900',
        ]}>Catálogo</a
      >

      <details class="group relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-ink-600 hover:bg-ink-100 hover:text-ink-900 [&::-webkit-details-marker]:hidden"
        >
          Categorías
          <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-180" viewBox="0 0 20 20"
            fill="currentColor"><path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"></path></svg
          >
        </summary>
        <div
          class="absolute right-0 top-full w-56 rounded-xl border border-ink-200 bg-white p-2 shadow-lg shadow-ink-900/5"
        >
          {
            categorias.map((cat) => (
              <a
                href={`/categoria/${cat.slug}`}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-ink-700 hover:bg-brand-50 hover:text-brand-800"
              >
                {cat.nombre}
              </a>
            ))
          }
        </div>
      </details>

      <a
        href="/contacto"
        class:list={[
          'rounded-lg px-3 py-2 text-sm font-medium',
          esActiva('/contacto')
            ? 'bg-brand-50 text-brand-800'
            : 'text-ink-600 hover:bg-ink-100 hover:text-ink-900',
        ]}>Contacto</a
      >
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/carrito"
        class="relative flex h-10 w-10 items-center justify-center rounded-xl border border-ink-200 bg-white text-ink-700 hover:bg-ink-50"
        aria-label="Ver carrito"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"></circle><circle
            cx="18" cy="20" r="1.4"></circle><path
            d="M2 3h2.5l2.2 11.1a1.8 1.8 0 001.8 1.4h8.4a1.8 1.8 0 001.8-1.4L20.5 7H6"
          ></path></svg
        >
        <span
          id="cart-count"
          class="absolute -right-1.5 -top-1.5 hidden min-w-[1.25rem] rounded-full bg-brand-600 px-1 text-center text-[11px] font-bold leading-5 text-white"
          >0</span
        >
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-ink-200 bg-white text-ink-700 hover:bg-ink-50 md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
      </button>
    </div>
  </div>

  <nav
    id="menu-movil"
    class="hidden border-t border-ink-200 bg-white px-4 py-3 md:hidden"
    aria-label="Menú móvil"
  >
    <div class="flex flex-col gap-1">
      <a href="/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-ink-100"
        >Inicio</a
      >
      <a
        href="/catalogo"
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-ink-100">Catálogo</a
      >
      {
        categorias.map((cat) => (
          <a
            href={`/categoria/${cat.slug}`}
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-ink-100"
          >
            {cat.nombre}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-ink-100">Contacto</a
      >
    </div>
  </nav>
</header>

<script>
  import { contar } from '../lib/store';

  function sincronizarContador() {
    const el = document.getElementById('cart-count');
    if (!el) return;
    const n = contar();
    el.textContent = String(n);
    el.classList.toggle('hidden', n === 0);
  }

  sincronizarContador();
  window.addEventListener('cart:changed', sincronizarContador);
  window.addEventListener('storage', sincronizarContador);

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');
  toggle?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(abierto));
    toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });
</script>
