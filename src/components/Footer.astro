---
import config from '../data/config.json';

const anio = new Date().getFullYear();
const redes = Object.entries(config.redes).filter(([, url]) => url && url.trim() !== '');
const etiquetasRedes: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  tiktok: 'TikTok',
};
---

<footer class="mt-16 border-t border-ink-200 bg-ink-50">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5">
        <span
          class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-lg font-extrabold text-white"
          >L</span
        >
        <span class="text-base font-extrabold tracking-tight text-ink-900">{config.nombre}</span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-ink-600">{config.slogan}.</p>
      <p class="mt-3 text-sm text-ink-600">{config.ubicacion}</p>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wide text-ink-900">Cómo comprar</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-600">
        <li>{config.entregas}</li>
        <li>{config.pagos}</li>
        <li>{config.horario}</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wide text-ink-900">Enlaces</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/catalogo" class="text-ink-600 hover:text-brand-700">Catálogo completo</a></li>
        <li><a href="/carrito" class="text-ink-600 hover:text-brand-700">Mi pedido</a></li>
        <li><a href="/contacto" class="text-ink-600 hover:text-brand-700">Contacto</a></li>
        <li>
          <a
            href={`https://wa.me/${config.whatsapp}`}
            class="text-ink-600 hover:text-brand-700"
            target="_blank"
            rel="noopener noreferrer">WhatsApp {config.whatsappVisible}</a
          >
        </li>
        {
          redes.map(([red, url]) => (
            <li>
              <a
                href={url}
                class="text-ink-600 hover:text-brand-700"
                target="_blank"
                rel="noopener noreferrer"
              >
                {etiquetasRedes[red] ?? red}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-200">
    <div class="mx-auto max-w-6xl px-4 py-5 text-center text-xs text-ink-500 sm:px-6">
      © {anio} {config.nombre}. Todos los derechos reservados.
    </div>
  </div>
</footer>
