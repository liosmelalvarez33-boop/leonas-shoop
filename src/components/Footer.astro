---
import config from '../data/config.json';

const anio = new Date().getFullYear();
const redes = Object.entries(config.redes).filter(([, url]) => url && url.trim() !== '');
const etiquetasRedes: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  tiktok: 'TikTok',
};
---

<footer class="mt-16 border-t border-line bg-sunken">
  <div class="h-1 bg-gradient-to-r from-brand-400 via-brand-600 to-brand-800"></div>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5">
        <img
          src="/img/logo.svg"
          alt=""
          width="36"
          height="36"
          class="h-9 w-9 rounded-[10px] shadow-sm"
        />
        <span class="text-base font-extrabold tracking-tight text-fg">
          Leonas <span class="text-accent">Shoop</span>
        </span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-fg-muted">{config.slogan}.</p>
      <p class="mt-3 text-sm text-fg-subtle">{config.ubicacion}</p>
      <a
        href={`https://wa.me/${config.whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3 py-1.5 text-xs font-semibold text-fg-muted transition hover:border-wa hover:text-wa-dark"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"
          ></path></svg
        >
        {config.whatsappVisible}
      </a>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wide text-fg">Cómo comprar</h2>
      <ul class="mt-3 space-y-2 text-sm text-fg-muted">
        <li>{config.entregas}</li>
        <li>{config.pagos}</li>
        <li>{config.horario}</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wide text-fg">Enlaces</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/catalogo" class="text-fg-muted hover:text-accent">Catálogo completo</a></li>
        <li><a href="/carrito" class="text-fg-muted hover:text-accent">Mi pedido</a></li>
        <li><a href="/contacto" class="text-fg-muted hover:text-accent">Contacto</a></li>
        <li>
          <a href="/apps/leonas-shoop.apk" class="text-fg-muted hover:text-accent">Descargar app (Android)</a>
        </li>
        {
          redes.map(([red, url]) => (
            <li>
              <a
                href={url}
                class="text-fg-muted hover:text-accent"
                target="_blank"
                rel="noopener noreferrer"
              >
                {etiquetasRedes[red] ?? red}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-5 text-center text-xs text-fg-subtle sm:px-6">
      © {anio} {config.nombre}. Todos los derechos reservados.
    </div>
  </div>
</footer>
