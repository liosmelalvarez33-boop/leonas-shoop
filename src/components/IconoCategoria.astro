---
interface Props {
  nombre?: string;
  class?: string;
}

const { nombre = 'otros', class: clase = 'h-6 w-6' } = Astro.props;
---

<svg
  class={clase}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    nombre === 'ropa' && (
      <path d="M9 3l3 2 3-2 5 3.5-2.4 3.4-2.1-1.1V21H8.5V8.8l-2.1 1.1L4 6.5 9 3z" />
    )
  }
  {
    nombre === 'zapatos' && (
      <>
        <path d="M2.5 16.6c1.8 0 2.9-1 3.9-2.5 1-1.5 2.4-3.4 4.4-3.4 1.5 0 2.2 1 3.5 1.5 1.4.5 3 .7 4 1.6 1 .8 1.7 1.5 1.7 2.5v1.6H2.5v-1.3z" />
        <path d="M2.5 19.5h19" />
      </>
    )
  }
  {
    nombre === 'accesorios' && (
      <>
        <path d="M5.6 8h12.8l-1.2 12.2a1 1 0 01-1 .8H7.8a1 1 0 01-1-.8L5.6 8z" />
        <path d="M9 8V6.5a3 3 0 016 0V8" />
      </>
    )
  }
  {
    nombre === 'hogar' && (
      <>
        <path d="M3 11l9-7 9 7v8.5a1.5 1.5 0 01-1.5 1.5H15v-6H9v6H4.5A1.5 1.5 0 013 19.5V11z" />
      </>
    )
  }
  {
    nombre === 'otros' && (
      <>
        <path d="M3 7.5l9-4.5 9 4.5v9L12 21l-9-4.5v-9z" />
        <path d="M3 7.5l9 4.5 9-4.5M12 12v9" />
      </>
    )
  }
</svg>
