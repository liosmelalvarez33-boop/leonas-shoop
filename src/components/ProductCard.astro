---
import type { Producto } from '../lib/types';
import { etiquetaCondicion } from '../lib/catalogo';
import { formatPrice } from '../lib/format';
import config from '../data/config.json';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const esNuevo = producto.condicion === 'nuevo';
const agotado = producto.estado === 'vendido';
const tallasResumen =
  producto.tallas.length > 0
    ? `Tallas ${producto.tallas[0]}${producto.tallas.length > 1 ? `-${producto.tallas[producto.tallas.length - 1]}` : ''}`
    : 'Única talla';
---

<article
  class:list={[
    'group card relative flex flex-col transition duration-200 hover:-translate-y-1 hover:border-brand-400 hover:shadow-lg hover:shadow-black/10',
    agotado && 'opacity-75',
  ]}
>
  <button
    type="button"
    data-fav={producto.id}
    data-titulo={producto.titulo}
    data-precio={producto.precio}
    data-imagen={producto.imagenes[0] ? `/img/productos/${producto.imagenes[0]}` : '/img/logo.svg'}
    aria-label={`Guardar ${producto.titulo} en favoritos`}
    aria-pressed="false"
    class="fav-btn absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-panel/90 text-fg-muted shadow-md backdrop-blur transition hover:scale-110 hover:text-rose-600"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 12.6L12 20l-7.5-7.4A5 5 0 1112 6.2a5 5 0 117.5 6.4z"></path></svg>
  </button>
  <a
    href={`/producto/${producto.id}`}
    class="flex flex-1 flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    <div class="relative aspect-[4/5] overflow-hidden bg-sunken">
      <img
        src={producto.imagenes[0] ? `/img/productos/${producto.imagenes[0]}` : '/img/logo.svg'}
        alt={producto.titulo}
        width="800"
        height="1000"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
      />
      <div class="absolute left-3 top-3 flex flex-col items-start gap-1.5">
        <span
          class:list={[
            'badge',
            esNuevo
              ? 'bg-emerald-100 text-emerald-800'
              : 'bg-brand-100 text-accent',
          ]}>{etiquetaCondicion[producto.condicion]}</span
        >
        {
          producto.estado !== 'disponible' && producto.estado !== 'vendido' && (
            <span class="badge bg-sky-100 text-sky-800">Reservado</span>
          )
        }
      </div>
      {
        agotado && (
          <div class="absolute inset-0 flex items-center justify-center bg-black/45">
            <span class="rounded-full bg-panel px-4 py-1.5 text-sm font-bold text-fg">
              Vendido
            </span>
          </div>
        )
      }
    </div>

    <div class="flex flex-1 flex-col p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-fg-faint">{tallasResumen}</p>
      <h3 class="mt-1 text-base font-bold leading-snug text-fg transition group-hover:text-accent">
        {producto.titulo}
      </h3>
      <p class="mt-1 line-clamp-2 text-sm text-fg-subtle">{producto.descripcion}</p>
      <p class="mt-3 text-lg font-extrabold text-fg">
        {config.simbolo}{formatPrice(producto.precio)}
        <span class="ml-1 text-xs font-semibold text-fg-faint">{config.moneda}</span>
      </p>
    </div>
  </a>
</article>
