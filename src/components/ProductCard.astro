---
import type { Producto } from '../lib/types';
import { etiquetaCondicion } from '../lib/catalogo';
import { formatPrice } from '../lib/format';
import config from '../data/config.json';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const esNuevo = producto.condicion === 'nuevo';
const agotado = producto.estado === 'vendido';
const tallasResumen =
  producto.tallas.length > 0
    ? `Tallas ${producto.tallas[0]}${producto.tallas.length > 1 ? `-${producto.tallas[producto.tallas.length - 1]}` : ''}`
    : 'Única talla';
---

<article
  class:list={[
    'group card relative flex flex-col transition hover:shadow-lg hover:shadow-ink-900/5',
    agotado && 'opacity-75',
  ]}
>
  <a href={`/producto/${producto.id}`} class="flex flex-1 flex-col focus-visible:outline-2">
    <div class="relative aspect-[4/5] overflow-hidden bg-ink-100">
      <img
        src={`/img/productos/${producto.imagenes[0]}`}
        alt={producto.titulo}
        width="800"
        height="1000"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
      />
      <div class="absolute left-3 top-3 flex flex-col items-start gap-1.5">
        <span
          class:list={[
            'badge',
            esNuevo
              ? 'bg-emerald-100 text-emerald-800'
              : 'bg-brand-100 text-brand-800',
          ]}>{etiquetaCondicion[producto.condicion]}</span
        >
        {
          producto.estado !== 'disponible' && producto.estado !== 'vendido' && (
            <span class="badge bg-sky-100 text-sky-800">Reservado</span>
          )
        }
      </div>
      {
        agotado && (
          <div class="absolute inset-0 flex items-center justify-center bg-ink-950/45">
            <span class="rounded-full bg-white px-4 py-1.5 text-sm font-bold text-ink-900">
              Vendido
            </span>
          </div>
        )
      }
    </div>

    <div class="flex flex-1 flex-col p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-ink-400">{tallasResumen}</p>
      <h3 class="mt-1 text-base font-bold leading-snug text-ink-900">{producto.titulo}</h3>
      <p class="mt-1 line-clamp-2 text-sm text-ink-500">{producto.descripcion}</p>
      <p class="mt-3 text-lg font-extrabold text-ink-900">
        {config.simbolo}{formatPrice(producto.precio)}
        <span class="ml-1 text-xs font-semibold text-ink-400">{config.moneda}</span>
      </p>
    </div>
  </a>
</article>
