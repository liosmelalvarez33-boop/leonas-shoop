---
// Barra inferior estilo app (solo <md): Inicio · Catálogo · [Carrito] · Favoritos · Contacto.
// El carrito central es el botón destacado con contador en vivo.
const rutaActual = Astro.url.pathname;
const esActiva = (ruta: string) =>
  ruta === '/' ? rutaActual === '/' : rutaActual.startsWith(ruta);

const iconos = {
  inicio: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 10.5L12 3.5l8.5 7"></path><path d="M5 10.7V20h5v-5.5h4V20h5v-9.3"></path></svg>`,
  catalogo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="7" height="7" rx="1.6"></rect><rect x="13" y="4" width="7" height="7" rx="1.6"></rect><rect x="4" y="13" width="7" height="7" rx="1.6"></rect><rect x="13" y="13" width="7" height="7" rx="1.6"></rect></svg>`,
  carrito: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h2.5l2.2 11.1a1.8 1.8 0 001.8 1.4h8.4a1.8 1.8 0 001.8-1.4L20.5 7H6"></path></svg>`,
  favoritos: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5 12.6L12 20l-7.5-7.4A5 5 0 1112 6.2a5 5 0 117.5 6.4z"></path></svg>`,
  contacto: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 01-9 8.4 8.7 8.7 0 01-3.8-.9L3 20l1-4.6a8.4 8.4 0 1117-3.9z"></path></svg>`,
};
---

<nav class="mnav" aria-label="Navegación principal (móvil)">
  <a href="/" class:list={['mnav-item', esActiva('/') && rutaActual === '/' && 'activo']}>
    <Fragment set:html={iconos.inicio} />
    <span>Inicio</span>
  </a>
  <a href="/catalogo" class:list={['mnav-item', esActiva('/catalogo') && 'activo']}>
    <Fragment set:html={iconos.catalogo} />
    <span>Catálogo</span>
  </a>

  <a href="/carrito" class="mnav-fab" aria-label="Ver carrito">
    <Fragment set:html={iconos.carrito} />
    <span id="cart-count-m" class="mnav-cnt hidden js-cart-count">0</span>
  </a>

  <a href="/favoritos" class:list={['mnav-item', esActiva('/favoritos') && 'activo']}>
    <Fragment set:html={iconos.favoritos} />
    <span>Favoritos</span>
    <span id="favs-count-m" class="mnav-cnt hidden js-fav-count bg-rose-600 text-white">0</span>
  </a>
  <a href="/contacto" class:list={['mnav-item', esActiva('/contacto') && 'activo']}>
    <Fragment set:html={iconos.contacto} />
    <span>Contacto</span>
  </a>
</nav>

<script>
  import { contar } from '../lib/store';

  function sincronizar() {
    const n = contar();
    for (const el of document.querySelectorAll<HTMLElement>('.js-cart-count')) {
      el.textContent = String(n);
      el.classList.toggle('hidden', n === 0);
    }
  }

  // Estado inicial (asincrónico: el store puede venir de otro evento)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', sincronizar, { once: true });
  } else {
    sincronizar();
  }
  window.addEventListener('cart:changed', sincronizar);
  window.addEventListener('storage', sincronizar);
</script>
