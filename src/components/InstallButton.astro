---
---
<button
  type="button"
  id="install-btn"
  class="hidden h-9 items-center gap-1.5 rounded-xl border border-brand-400 bg-brand-50 px-2.5 text-sm font-semibold text-accent transition hover:bg-brand-100 sm:px-3"
  title="Instalar la app en tu celular"
>
  <svg class="h-4.5 w-4.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"
    ><path d="M12 3v11m0 0l-4.5-4.5M12 14l4.5-4.5M4.5 20.5h15"></path></svg
  >
  <span class="hidden md:inline">Instalar</span>
</button>

<div
  id="install-help"
  class="fixed bottom-20 left-1/2 z-[60] hidden w-[min(22rem,calc(100vw-2rem))] -translate-x-1/2 rounded-2xl border border-line bg-panel p-4 text-sm shadow-2xl shadow-black/25"
  role="status"
>
  <p class="font-bold text-fg">📲 Instalar Leonas Shoop</p>
  <p id="install-help-texto" class="mt-1.5 leading-relaxed text-fg-muted"></p>
  <a
    id="install-apk"
    href="/apps/leonas-shoop.apk"
    class="mt-2 hidden w-full rounded-xl bg-brand-600 py-2 text-center text-xs font-bold text-white"
    >⬇ Descargar app (.apk)</a
  >
  <button type="button" id="install-help-cerrar" class="mt-3 w-full rounded-xl bg-sunken py-2 text-xs font-semibold text-fg-muted"
    >Entendido</button
  >
</div>

<script>
  const boton = document.getElementById('install-btn');
  const ayuda = document.getElementById('install-help');
  const textoAyuda = document.getElementById('install-help-texto');
  const cerrarAyuda = document.getElementById('install-help-cerrar');

  let eventoDeInstalacion: any = null;
  let aviso: ReturnType<typeof setTimeout>;

  const yaInstalada = () =>
    window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as any).standalone === true;

  if (!yaInstalada()) boton?.classList.remove('hidden');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    eventoDeInstalacion = e;
    boton?.classList.remove('hidden');
  });

  window.addEventListener('appinstalled', () => boton?.classList.add('hidden'));

  function mostrarAyuda() {
    const ua = navigator.userAgent;
    const esIOS =
      /iPad|iPhone|iPod/.test(ua) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const esAndroid = /Android/.test(ua);
    document.getElementById('install-apk')?.classList.toggle('hidden', !esAndroid);
    if (textoAyuda) {
      textoAyuda.textContent = esIOS
        ? 'En Safari: toca el botón Compartir ▲ y elige «Añadir a pantalla de inicio».'
        : esAndroid
          ? 'Abre el menú ⋮ de Chrome y toca «Instalar aplicación» (o «Añadir a pantalla de inicio»).'
          : 'Abre el menú ⋮ de Chrome y toca «Instalar Leonas Shoop…» o «Instalar aplicación».';
    }
    ayuda?.classList.remove('hidden');
    clearTimeout(aviso);
    aviso = setTimeout(() => ayuda?.classList.add('hidden'), 8000);
  }

  boton?.addEventListener('click', async () => {
    if (eventoDeInstalacion) {
      eventoDeInstalacion.prompt();
      try {
        await eventoDeInstalacion.userChoice;
      } catch {
        /* cancelado */
      }
      eventoDeInstalacion = null;
      return;
    }
    mostrarAyuda();
  });

  cerrarAyuda?.addEventListener('click', () => ayuda?.classList.add('hidden'));
</script>
