---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe.">
  <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <p class="text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 text-2xl font-extrabold text-ink-900">Página no encontrada</h1>
    <p class="mt-2 text-sm text-ink-600">
      El enlace puede estar roto o el artículo ya no está disponible.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-base btn-primary">Ir al inicio</a>
      <a href="/catalogo" class="btn-base btn-outline">Ver catálogo</a>
    </div>
  </div>
</Base>
