---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { categorias, porCategoria } from '../../lib/catalogo';
import { waLink, mensajeGeneral } from '../../lib/whatsapp';

export function getStaticPaths() {
  return categorias.map((categoria) => ({
    params: { slug: categoria.slug },
    props: { categoria },
  }));
}

const { categoria } = Astro.props;
const lista = porCategoria(categoria.slug);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: categoria.nombre,
  description: categoria.descripcion,
};
---

<Base title={categoria.nombre} description={categoria.descripcion} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav aria-label="Migas de pan" class="text-sm text-fg-subtle">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-accent">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/catalogo" class="hover:text-accent">Catálogo</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-fg-muted">{categoria.nombre}</li>
      </ol>
    </nav>

    <header class="mt-6">
      <span class="kicker">Categoría</span>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-fg">{categoria.nombre}</h1>
      <p class="mt-2 text-sm text-fg-muted">
        {categoria.descripcion}
        {lista.length} artículo{lista.length === 1 ? '' : 's'} disponible{lista.length === 1 ? '' : 's'}.
      </p>
    </header>

    {
      lista.length > 0 ? (
        <div class="mt-8 grid grid-cols-2 gap-5 md:grid-cols-3 xl:grid-cols-4">
          {lista.map((p) => (
            <ProductCard producto={p} />
          ))}
        </div>
      ) : (
        <div class="mt-8 rounded-2xl border border-dashed border-line-2 p-10 text-center">
          <p class="text-lg font-bold text-fg">Aún no hay artículos en esta categoría</p>
          <p class="mt-1 text-sm text-fg-subtle">
            Estamos cargando productos nuevos. Escríbenos por WhatsApp para consultas.
          </p>
          <div class="mt-5 flex justify-center gap-3">
            <a href="/catalogo" class="btn-base btn-outline">
              Ver todo el catálogo
            </a>
            <a
              href={waLink(mensajeGeneral())}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-base btn-wa"
            >
              WhatsApp
            </a>
          </div>
        </div>
      )
    }
  </div>

  <CtaBanner />
</Base>
