---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductImage from '../../components/ProductImage.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import SizeGuide from '../../components/SizeGuide.astro';
import { productos, porCategoria, categoriaDe } from '../../lib/catalogo';
import { mensajeProducto, waLink } from '../../lib/whatsapp';
import { formatPrice } from '../../lib/format';
import config from '../../data/config.json';
import type { Producto } from '../../lib/types';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { id: p.id }, props: { producto: p } }));
}

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const cat = categoriaDe(producto.categoria);
const relacionados = porCategoria(producto.categoria).filter((p) => p.id !== producto.id && p.estado !== 'vendido').slice(0, 4);
const disponibles = relacionados.length > 0 ? relacionados : productos.filter((p) => p.id !== producto.id && p.estado !== 'vendido').slice(0, 4);

const disponible = producto.estado === 'disponible';
const imgBase = (producto.imagenes[0] || 'logo.svg').replace(/\.[a-z0-9]+$/i, '');
const ogImage = `/img/optimizadas/${imgBase}-800.jpg`;

const waProducto = waLink(mensajeProducto(producto, {}));

const ETQ_COND: Record<string, string> = { nuevo: 'Nuevo', 'segundo-uso': 'Segundo uso' };
const ETQ_EST: Record<string, string> = { disponible: 'Disponible', reservado: 'Reservado', vendido: 'Vendido' };

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: producto.titulo,
  description: producto.descripcion,
  image: [`${config.site}/img/productos/${producto.imagenes[0] || 'logo.svg'}`],
  category: cat?.nombre || producto.categoria,
  brand: { '@type': 'Brand', name: config.nombre },
  offers: {
    '@type': 'Offer',
    url: `${config.site}/producto/${producto.id}`,
    priceCurrency: 'CUP',
    price: String(producto.precio),
    availability:
      producto.estado === 'disponible'
        ? 'https://schema.org/InStock'
        : producto.estado === 'reservado'
          ? 'https://schema.org/LimitedAvailability'
          : 'https://schema.org/OutOfStock',
    seller: { '@type': 'Store', name: config.nombre },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${config.site}/` },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: `${config.site}/catalogo` },
    ...(cat ? [{ '@type': 'ListItem', position: 3, name: cat.nombre, item: `${config.site}/catalogo?categoria=${cat.slug}` }] : []),
    { '@type': 'ListItem', position: 4, name: producto.titulo },
  ],
};
---

<Base
  title={producto.titulo}
  description={`${producto.titulo} - ${ETQ_COND[producto.condicion]} · ${ETQ_EST[producto.estado]} · $${formatPrice(producto.precio)} ${config.moneda}. ${producto.descripcion.slice(0, 140)}`}
  image={ogImage}
  type="product"
  jsonLd={[productLd, breadcrumbLd]}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Migas de pan" class="text-xs text-fg-subtle">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-accent">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/catalogo" class="hover:text-accent">Catálogo</a></li>
        {cat && (
          <>
            <li aria-hidden="true">/</li>
            <li><a href={`/catalogo?categoria=${cat.slug}`} class="hover:text-accent">{cat.nombre}</a></li>
          </>
        )}
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-fg">{producto.titulo}</li>
      </ol>
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-2">
      <div>
        <div class="overflow-hidden rounded-2xl border border-line bg-sunken">
          <ProductImage nombre={producto.imagenes[0] || 'logo.svg'} alt={producto.titulo} eager={true} />
        </div>
        {producto.imagenes.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-3">
            {producto.imagenes.map((img, i) => (
              <div class="overflow-hidden rounded-xl border border-line bg-sunken">
                <ProductImage nombre={img} alt={`${producto.titulo} foto ${i + 1}`} />
              </div>
            ))}
          </div>
        )}
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class:list={['badge', producto.condicion === 'nuevo' ? 'bg-emerald-100 text-emerald-800' : 'bg-brand-100 text-accent']}>{ETQ_COND[producto.condicion]}</span>
          <span class:list={['badge', producto.estado === 'disponible' ? 'bg-emerald-50 text-emerald-700' : producto.estado === 'reservado' ? 'bg-sky-100 text-sky-800' : 'bg-rose-100 text-rose-800']}>{ETQ_EST[producto.estado]}</span>
          {cat && <a href={`/catalogo?categoria=${cat.slug}`} class="badge bg-sunken text-fg-muted hover:text-accent">{cat.nombre}</a>}
        </div>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-fg">{producto.titulo}</h1>
        <p class="mt-4 flex items-baseline gap-2 text-4xl font-extrabold text-accent">
          <span>{config.simbolo}{formatPrice(producto.precio)}</span>
          <span class="text-sm font-semibold text-fg-faint">{config.moneda}</span>
        </p>
        <p class="mt-4 leading-relaxed text-fg-muted">{producto.descripcion}</p>
        {producto.tallas.length > 0 && (
          <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-fg-muted">
            <p><strong class="text-fg">Tallas:</strong> {producto.tallas.join(', ')}</p>
            <button
              type="button"
              data-abrir-guia
              class="text-xs font-semibold text-accent hover:underline"
            >
              Ver guía de tallas
            </button>
          </div>
        )}
        {!disponible && (
          <form data-espera={producto.id} class="mt-6 space-y-3 rounded-2xl border border-line bg-sunken p-4">
            <p class="text-sm font-bold text-fg">Avísame cuando esté disponible</p>
            <p class="text-xs text-fg-subtle">Te escribimos por WhatsApp en cuanto vuelva.</p>
            <div class="grid gap-2 sm:grid-cols-2">
              <input
                name="nombre"
                required
                maxlength="120"
                placeholder="Tu nombre"
                autocomplete="name"
                class="input"
              />
              <input
                name="telefono"
                required
                inputmode="tel"
                placeholder="Tu WhatsApp (ej: 5354704764)"
                autocomplete="tel"
                class="input"
              />
            </div>
            <button type="submit" class="btn-base btn-dark w-full sm:w-auto">Avisarme</button>
            <p data-espera-msg class="hidden text-xs font-semibold"></p>
          </form>
        )}
        {!disponible && producto.estado === 'reservado' && (
          <p class="mt-4 text-sm font-semibold text-sky-700">Reservado: pregúntanos por lista de espera.</p>
        )}
        {!disponible && producto.estado === 'vendido' && (
          <p class="mt-4 text-sm font-semibold text-rose-600">Vendido: escríbenos por si llega otra talla o similar.</p>
        )}
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={`/catalogo?p=${producto.id}`} class="btn-base btn-primary flex-1 text-center">
            {disponible ? 'Elegir talla y añadir' : 'Ver en catálogo'}
          </a>
          <a href={waProducto} target="_blank" rel="noopener noreferrer" class="btn-base btn-wa flex-1 text-center">
            {disponible ? 'Pedir por WhatsApp' : 'Preguntar por WhatsApp'}
          </a>
        </div>
        <ul class="mt-8 space-y-2 border-t border-line pt-6 text-sm text-fg-muted">
          <li>✓ {config.entregas}</li>
          <li>✓ {config.pagos}</li>
          <li>✓ {config.horario}</li>
        </ul>
      </div>
    </div>

    {disponibles.length > 0 && (
      <section class="mt-14">
        <div class="flex items-end justify-between gap-4">
          <h2 class="text-2xl font-extrabold tracking-tight text-fg">También te puede interesar</h2>
          <a href="/catalogo" class="text-sm font-semibold text-accent hover:underline">Ver todo →</a>
        </div>
        <div class="mt-6 grid grid-cols-2 gap-5 md:grid-cols-3 xl:grid-cols-4">
          {disponibles.map((p) => <ProductCard producto={p} />)}
        </div>
      </section>
    )}
  </div>

  <CtaBanner />

  <SizeGuide />

  <script>
    import { showToast } from '../../scripts/toast';
    import { track } from '../../lib/analytics';

    document.querySelector('[data-abrir-guia]')?.addEventListener('click', () => {
      (document.getElementById('guia-tallas') as HTMLDialogElement | null)?.showModal();
    });

    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-espera]')) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = form.querySelector('[data-espera-msg]') as HTMLElement;
        const fd = new FormData(form);
        try {
          const r = await fetch('/api/lista-espera', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              product_id: form.dataset.espera,
              nombre: String(fd.get('nombre') || ''),
              telefono: String(fd.get('telefono') || ''),
            }),
          });
          const d = await r.json().catch(() => null);
          if (r.ok) {
            msg.textContent = '✓ Te avisaremos por WhatsApp.';
            msg.className = 'text-xs font-semibold text-emerald-700';
            track('espera_add', { producto_id: form.dataset.espera || '' });
            showToast('Guardado en lista de espera');
            form.reset();
          } else {
            msg.textContent = d?.error || 'No se pudo guardar.';
            msg.className = 'text-xs font-semibold text-rose-600';
          }
        } catch {
          msg.textContent = 'Sin conexión. Intenta de nuevo.';
          msg.className = 'text-xs font-semibold text-rose-600';
        }
        msg.classList.remove('hidden');
      });
    }
  </script>
</Base>
