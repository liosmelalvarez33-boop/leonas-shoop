---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  productos,
  categoriaDe,
  etiquetaCondicion,
  etiquetaEstado,
  relacionados,
} from '../../lib/catalogo';
import { formatPrice } from '../../lib/format';
import config from '../../data/config.json';
import type { Producto } from '../../lib/types';

interface Props {
  producto: Producto;
}

export function getStaticPaths() {
  return productos.map((producto) => ({ params: { id: producto.id }, props: { producto } }));
}

const { producto } = Astro.props;
const categoria = categoriaDe(producto.categoria);
const relacionadosLista = relacionados(producto);
const disponible = producto.estado === 'disponible';
const esNuevo = producto.condicion === 'nuevo';

const schemaDisponibilidad = disponible
  ? 'https://schema.org/InStock'
  : producto.estado === 'reservado'
    ? 'https://schema.org/PreOrder'
    : 'https://schema.org/OutOfStock';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: producto.titulo,
  description: producto.descripcion,
  image: producto.imagenes.map((img) => `${config.site}/img/productos/${img}`),
  url: `${config.site}/producto/${producto.id}`,
  brand: { '@type': 'Brand', name: config.nombre },
  offers: {
    '@type': 'Offer',
    url: `${config.site}/producto/${producto.id}`,
    priceCurrency: 'CUP',
    price: producto.precio,
    availability: schemaDisponibilidad,
    itemCondition: esNuevo
      ? 'https://schema.org/NewCondition'
      : 'https://schema.org/UsedCondition',
  },
};
---

<Base
  title={producto.titulo}
  description={`${producto.titulo} - ${config.simbolo}${formatPrice(producto.precio)} ${config.moneda}. ${producto.condicion === 'nuevo' ? 'Nuevo' : 'Segundo uso'} en Leonas Shoop. Pide por WhatsApp.`}
  image={`/img/productos/${producto.imagenes[0]}`}
  type="product"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav aria-label="Migas de pan" class="text-sm text-ink-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-brand-700">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/catalogo" class="hover:text-brand-700">Catálogo</a></li>
        {
          categoria && (
            <>
              <li aria-hidden="true">/</li>
              <li>
                <a href={`/categoria/${categoria.slug}`} class="hover:text-brand-700">
                  {categoria.nombre}
                </a>
              </li>
            </>
          )
        }
        <li aria-hidden="true">/</li>
        <li class="font-medium text-ink-800">{producto.titulo}</li>
      </ol>
    </nav>

    <div
      class="mt-6 grid gap-10 lg:grid-cols-2"
      data-product-root
      data-id={producto.id}
      data-titulo={producto.titulo}
      data-precio={producto.precio}
      data-estado={producto.estado}
      data-imagen={producto.imagenes[0]}
      data-tiene-tallas={producto.tallas.length > 0 ? '1' : '0'}
    >
      <div>
        <div
          class="overflow-hidden rounded-2xl border border-ink-200 bg-ink-100"
          id="galeria-principal"
        >
          <img
            src={`/img/productos/${producto.imagenes[0]}`}
            alt={producto.titulo}
            width="800"
            height="1000"
            id="imagen-principal"
            class="aspect-[4/5] w-full object-cover"
            decoding="async"
          />
        </div>
        {
          producto.imagenes.length > 1 && (
            <div class="mt-3 grid grid-cols-4 gap-3">
              {producto.imagenes.map((img, i) => (
                <button
                  type="button"
                  class:list={[
                    'overflow-hidden rounded-xl border-2 bg-ink-100',
                    i === 0 ? 'border-brand-600' : 'border-transparent',
                  ]}
                  data-miniatura={`/img/productos/${img}`}
                  aria-label={`Ver imagen ${i + 1}`}
                >
                  <img
                    src={`/img/productos/${img}`}
                    alt=""
                    width="200"
                    height="250"
                    loading="lazy"
                    class="aspect-[4/5] w-full object-cover"
                  />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span
            class:list={[
              'badge',
              esNuevo ? 'bg-emerald-100 text-emerald-800' : 'bg-brand-100 text-brand-800',
            ]}>{etiquetaCondicion[producto.condicion]}</span
          >
          <span
            class:list={[
              'badge',
              disponible
                ? 'bg-emerald-50 text-emerald-700'
                : producto.estado === 'reservado'
                  ? 'bg-sky-100 text-sky-800'
                  : 'bg-rose-100 text-rose-800',
            ]}>{etiquetaEstado[producto.estado]}</span
          >
          <span class="badge bg-ink-100 text-ink-600">{categoria?.nombre}</span>
        </div>

        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-ink-900">
          {producto.titulo}
        </h1>

        <p class="mt-3 text-4xl font-extrabold text-ink-900">
          {config.simbolo}{formatPrice(producto.precio)}
          <span class="ml-2 align-middle text-sm font-semibold text-ink-400"
            >{config.moneda}</span
          >
        </p>

        <p class="mt-4 leading-relaxed text-ink-600">{producto.descripcion}</p>

        {
          producto.tallas.length > 0 && (
            <div class="mt-6">
              <p class="mb-2 text-sm font-bold text-ink-900">
                Talla <span id="talla-elegida" class="font-medium text-ink-500">(elige una)</span>
              </p>
              <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Seleccionar talla">
                {producto.tallas.map((t) => (
                  <button
                    type="button"
                    class="chip"
                    role="radio"
                    aria-checked="false"
                    data-talla={t}
                  >
                    {t}
                  </button>
                ))}
              </div>
            </div>
          )
        }

        <div class="mt-6 flex items-center gap-4">
          <div class="flex items-center rounded-xl border border-ink-300">
            <button
              type="button"
              id="qty-menos"
              class="px-3.5 py-2.5 text-lg font-bold text-ink-600 hover:text-ink-900"
              aria-label="Reducir cantidad">−</button
            >
            <span
              id="qty-val"
              class="min-w-[2.5rem] text-center text-sm font-bold text-ink-900"
              aria-live="polite">1</span
            >
            <button
              type="button"
              id="qty-mas"
              class="px-3.5 py-2.5 text-lg font-bold text-ink-600 hover:text-ink-900"
              aria-label="Aumentar cantidad">+</button
            >
          </div>
          {
            !disponible && (
              <p class="text-sm font-semibold text-rose-600">
                {producto.estado === 'vendido'
                  ? 'Este artículo ya se vendió.'
                  : 'Este artículo está reservado.'}
              </p>
            )
          }
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          {
            disponible && (
              <button type="button" id="btn-add" class="btn-base btn-primary flex-1">
                Añadir al carrito
              </button>
            )
          }
          <button type="button" id="btn-wa" class:list={['btn-base btn-wa', !disponible && 'flex-1']}>
            {
              disponible
                ? 'Pedir por WhatsApp'
                : producto.estado === 'reservado'
                  ? 'Preguntar por lista de espera'
                  : 'Preguntar por disponibilidad'
            }
          </button>
        </div>

        <ul class="mt-8 space-y-3 border-t border-ink-200 pt-6 text-sm text-ink-600">
          <li class="flex gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="currentColor"
              ><path
                fill-rule="evenodd"
                d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                clip-rule="evenodd"></path></svg
            >{config.entregas}
          </li>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="currentColor"
              ><path
                fill-rule="evenodd"
                d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                clip-rule="evenodd"></path></svg
            >{config.pagos}
          </li>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="currentColor"
              ><path
                fill-rule="evenodd"
                d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                clip-rule="evenodd"></path></svg
            >{config.horario}
          </li>
        </ul>
      </div>
    </div>

    {
      relacionadosLista.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-extrabold tracking-tight text-ink-900">
            Te puede interesar
          </h2>
          <div class="mt-6 grid grid-cols-2 gap-5 md:grid-cols-3 xl:grid-cols-4">
            {relacionadosLista.map((p) => (
              <ProductCard producto={p} />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <script>
    import { addToCart } from '../../lib/store';
    import { mensajeProducto, waLink } from '../../lib/whatsapp';
    import { showToast } from '../../scripts/toast';

    const root = document.querySelector<HTMLElement>('[data-product-root]');
    if (root) {
      const d = root.dataset;
      const tieneTallas = d.tieneTallas === '1';
      const estado = d.estado ?? 'disponible';
      const titulo = d.titulo ?? '';
      const precio = Number(d.precio ?? 0);
      const id = d.id ?? '';
      const imagen = d.imagen ?? '';

      let talla: string | null = null;
      let cantidad = 1;

      const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-talla]')];
      const labelTalla = root.querySelector<HTMLElement>('#talla-elegida');
      for (const chip of chips) {
        chip.addEventListener('click', () => {
          chips.forEach((c) => {
            c.classList.remove('is-active');
            c.setAttribute('aria-checked', 'false');
          });
          chip.classList.add('is-active');
          chip.setAttribute('aria-checked', 'true');
          talla = chip.dataset.talla ?? null;
          if (labelTalla) labelTalla.textContent = `(talla ${talla})`;
        });
      }

      const qtyEl = root.querySelector<HTMLElement>('#qty-val');
      root.querySelector('#qty-menos')?.addEventListener('click', () => {
        cantidad = Math.max(1, cantidad - 1);
        if (qtyEl) qtyEl.textContent = String(cantidad);
      });
      root.querySelector('#qty-mas')?.addEventListener('click', () => {
        cantidad = Math.min(20, cantidad + 1);
        if (qtyEl) qtyEl.textContent = String(cantidad);
      });

      function tallaOk(): boolean {
        if (tieneTallas && !talla) {
          showToast('Primero elige la talla', 'error');
          return false;
        }
        return true;
      }

      root.querySelector('#btn-add')?.addEventListener('click', () => {
        if (!tallaOk()) return;
        addToCart({ id, titulo, precio, talla, cantidad, imagen });
        showToast('Añadido al carrito');
      });

      root.querySelector('#btn-wa')?.addEventListener('click', () => {
        if (!tallaOk()) return;
        const texto = mensajeProducto({ titulo, precio, tallas: tieneTallas ? ['x'] : [] }, { talla, cantidad });
        window.open(waLink(texto), '_blank', 'noopener');
      });

      const imgPrincipal = root.querySelector<HTMLImageElement>('#imagen-principal');
      for (const mini of root.querySelectorAll<HTMLButtonElement>('[data-miniatura]')) {
        mini.addEventListener('click', () => {
          if (!imgPrincipal) return;
          imgPrincipal.src = mini.dataset.miniatura ?? imgPrincipal.src;
          root
            .querySelectorAll('[data-miniatura]')
            .forEach((m) => m.classList.replace('border-brand-600', 'border-transparent'));
          mini.classList.replace('border-transparent', 'border-brand-600');
        });
      }

      if (estado === 'vendido') {
        const add = root.querySelector<HTMLButtonElement>('#btn-add');
        if (add) add.disabled = true;
      }
    }
  </script>
</Base>
